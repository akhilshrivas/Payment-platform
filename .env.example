# ============================================================
# Application
# ============================================================
DEBUG=True
SECRET_KEY=django-insecure-change-this-in-production-use-50-char-random-string
DJANGO_SETTINGS_MODULE=config.settings.development
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# ============================================================
# PostgreSQL
# ============================================================
POSTGRES_DB=payment_platform
POSTGRES_USER=payment_user
POSTGRES_PASSWORD=payment_pass_change_in_prod
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ============================================================
# Redis
# ============================================================
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ============================================================
# Razorpay — Use TEST keys (rzp_test_...)
# NEVER put rzp_live_... keys here. Set in production secrets.
# ============================================================
RAZORPAY_KEY_ID=rzp_test_REPLACE_WITH_YOUR_KEY_ID
RAZORPAY_KEY_SECRET=REPLACE_WITH_YOUR_KEY_SECRET
RAZORPAY_WEBHOOK_SECRET=REPLACE_WITH_YOUR_WEBHOOK_SECRET

# ============================================================
# Frontend (exposed to React via VITE_ prefix — public only)
# ============================================================
FRONTEND_URL=http://localhost:5173
VITE_API_URL=http://localhost:8000
VITE_RAZORPAY_KEY_ID=rzp_test_REPLACE_WITH_YOUR_KEY_ID

# ============================================================
# Email — console backend for development
# For production, switch to smtp and fill SMTP credentials
# ============================================================
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@paymentplatform.com

# ============================================================
# JWT
# ============================================================
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=30
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7
