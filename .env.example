# ==========================================
# Core Django Config
# ==========================================
# IMPORTANT: Change this to a highly secure, random string for production
SECRET_KEY=your_production_secret_key_here
DEBUG=False

# Comma-separated list of allowed hostnames (e.g. api.yourdomain.com,yourdomain.com)
ALLOWED_HOSTS=app.yourdomain.com,api.yourdomain.com

# ==========================================
# CORS & CSRF
# ==========================================
# URL of your frontend application
FRONTEND_URL=https://app.yourdomain.com

# For production, restrict this strictly to your frontend domain
CORS_ALLOWED_ORIGINS=https://app.yourdomain.com

# Needed if HTTPS proxy modifies scheme
CSRF_TRUSTED_ORIGINS=https://app.yourdomain.com,https://api.yourdomain.com

# ==========================================
# Database (PostgreSQL)
# ==========================================
POSTGRES_DB=payment_platform
POSTGRES_USER=db_user
POSTGRES_PASSWORD=db_super_secret_password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ==========================================
# Redis / Celery
# ==========================================
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ==========================================
# Razorpay Configuration
# ==========================================
# Use Live mode credentials for real production, Test mode for sandbox
RAZORPAY_KEY_ID=rzp_live_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret_key
RAZORPAY_WEBHOOK_SECRET=your_secure_webhook_secret

# ==========================================
# JWT Configuration
# ==========================================
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=30
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# ==========================================
# Frontend Configuration
# ==========================================
# Injected into the frontend during build time
FRONTEND_API_URL=https://app.yourdomain.com/api

# ==========================================
# Email (SMTP) Configuration
# ==========================================
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.your-provider.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your_email@yourdomain.com
EMAIL_HOST_PASSWORD=your_email_smtp_password
DEFAULT_FROM_EMAIL=noreply@yourdomain.com

# ==========================================
# AI Assistant Settings
# ==========================================
AI_PROVIDER=openai
AI_API_KEY=
AI_MODEL=gpt-4o-mini
